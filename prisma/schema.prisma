  /// v3.1: belgini admin qo‘yadi, hujjat shart emas.
  fileId             String?    @map("file_id") @db.Uuid
  validFrom          DateTime   @map("valid_from") @db.Date
  validUntil         DateTime?  @map("valid_until") @db.Date
  status             CertStatus @default(PENDING)
  reviewerId         String?    @map("reviewer_id") @db.Uuid
  reviewedAt         DateTime?  @map("reviewed_at")
  reason             String?    @db.VarChar(1000)
  expiringNotifiedAt DateTime?  @map("expiring_notified_at")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  shop               Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, status])
  @@index([validUntil])
  @@map("shop_certifications")
}

/// Portfolio loyihasi (TZ 7.3). installationId — "Tasdiqlangan montaj" belgisi.
model ShopProject {
  id             String             @id @default(uuid()) @db.Uuid
  shopId         String             @map("shop_id") @db.Uuid
  title          String             @db.VarChar(200)
  city           String?            @db.VarChar(120)
  systemPowerKw  Decimal?           @map("system_power_kw") @db.Decimal(10, 2)
  systemType     SystemType?        @map("system_type")
  completedAt    DateTime?          @map("completed_at") @db.Date
  installationId String?            @map("installation_id") @db.Uuid
  description    String?            @db.VarChar(4000)
  published      Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  shop           Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  images         ShopProjectImage[]

  @@index([shopId])
  @@map("shop_projects")
}

model ShopProjectImage {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  fileId    String      @map("file_id") @db.Uuid
  sortOrder Int         @default(0) @map("sort_order")
  project   ShopProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("shop_project_images")
}

/// Embed vidjet (TZ 4.15, 13.6, U13): faqat allowedDomains dan (CSP frame-ancestors).
model WidgetConfig {
  id             String   @id @default(uuid()) @db.Uuid
  shopId         String   @unique @map("shop_id") @db.Uuid
  publicKey      String   @unique @map("public_key") @db.VarChar(40)
  allowedDomains String[] @default([]) @map("allowed_domains")
  themeJson      Json     @default("{}") @map("theme_json")
  active         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("widget_configs")
}

/// Funnel va do‘kon analitikasi (TZ 7.7): PII yo‘q; 24 oy saqlanadi.
model AnalyticsEvent {
  id             String   @id @default(uuid()) @db.Uuid
  eventType      String   @map("event_type") @db.VarChar(60)
  userId         String?  @map("user_id") @db.Uuid
  anonymousId    String?  @map("anonymous_id") @db.VarChar(64)
  shopId         String?  @map("shop_id") @db.Uuid
  entityId       String?  @map("entity_id") @db.Uuid
  regionCode     String?  @map("region_code") @db.VarChar(32)
  propertiesJson Json     @default("{}") @map("properties_json")
  occurredAt     DateTime @default(now()) @map("occurred_at")

  @@index([eventType, occurredAt])
  @@index([shopId, occurredAt])
  @@map("analytics_events")
}

enum SupportPriority {
  URGENT
  HIGH
  NORMAL
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum SupportSide {
  USER
  AGENT
  SYSTEM
}

/// Yordam markazi (TZ 4.20, 7.7): SUP-000123, ish vaqti bo‘yicha birinchi javob muddati.
model SupportTicket {
  id                 String           @id @default(uuid()) @db.Uuid
  number             Int              @unique @default(autoincrement())
  requesterUserId    String?          @map("requester_user_id") @db.Uuid
  guestContact       String?          @map("guest_contact") @db.VarChar(64)
  shopId             String?          @map("shop_id") @db.Uuid
  category           String           @db.VarChar(40)
  subject            String           @db.VarChar(200)
  priority           SupportPriority  @default(NORMAL)
  status             SupportStatus    @default(OPEN)
  relatedType        String?          @map("related_type") @db.VarChar(40)
  relatedId          String?          @map("related_id") @db.Uuid
  requestIdRef       String?          @map("request_id_ref") @db.VarChar(100)
  assigneeId         String?          @map("assignee_id") @db.Uuid
  firstResponseDueAt DateTime         @map("first_response_due_at")
  firstRespondedAt   DateTime?        @map("first_responded_at")
  slaWarnedAt        DateTime?        @map("sla_warned_at")
  resolvedAt         DateTime?        @map("resolved_at")
  closedAt           DateTime?        @map("closed_at")
  satisfaction       Int?
  lastMessageAt      DateTime         @default(now()) @map("last_message_at")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  messages           SupportMessage[]

  @@index([status, priority, firstResponseDueAt])
  @@index([requesterUserId])
  @@map("support_tickets")
}

model SupportMessage {
  id                String        @id @default(uuid()) @db.Uuid
  ticketId          String        @map("ticket_id") @db.Uuid
  senderUserId      String?       @map("sender_user_id") @db.Uuid
  senderSide        SupportSide   @map("sender_side")
  body              String        @db.VarChar(8000)
  attachmentFileIds String[]      @default([]) @map("attachment_file_ids") @db.Uuid
  isInternal        Boolean       @default(false) @map("is_internal")
  createdAt         DateTime      @default(now())
  ticket            SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model SupportReplyTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  titleI18n Json     @map("title_i18n")
  bodyI18n  Json     @map("body_i18n")
  category  String?  @db.VarChar(40)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("support_reply_templates")
}

enum ArticleType {
  GUIDE
  ARTICLE
  FAQ
  VIDEO
  GLOSSARY
}

enum CtaType {
  CALCULATOR
  OUTAGE
  FINANCING
  SHOPS
  NONE
}

model KnowledgeCategory {
  id        String         @id @default(uuid()) @db.Uuid
  slug      String         @unique @db.VarChar(120)
  nameI18n  Json           @map("name_i18n")
  icon      String?        @db.VarChar(40)
  parentId  String?        @map("parent_id") @db.Uuid
  sortOrder Int            @default(0) @map("sort_order")
  articles  GuideArticle[]

  @@map("knowledge_categories")
}

/// Bilimlar markazi (TZ 4.19, 7.7): 3 tilda (uz/oz/ru), Markdown, SEO; title/body trigram indeks (SQL).
model GuideArticle {
  id                 String            @id @default(uuid()) @db.Uuid
  slug               String            @unique @db.VarChar(160)
  articleType        ArticleType       @map("article_type")
  categoryId         String            @map("category_id") @db.Uuid
  titleI18n          Json              @map("title_i18n")
  summaryI18n        Json              @map("summary_i18n")
  bodyI18n           Json              @map("body_i18n")
  /// Qidiruv uchun barcha tillardagi sarlavha va matn (trigram).
  searchText         String            @default("") @map("search_text")
  videoUrl           String?           @map("video_url") @db.VarChar(500)
  coverFileId        String?           @map("cover_file_id") @db.Uuid
  tags               String[]          @default([])
  seoTitleI18n       Json?             @map("seo_title_i18n")
  seoDescriptionI18n Json?             @map("seo_description_i18n")
  ctaType            CtaType           @default(NONE) @map("cta_type")
  authorId           String?           @map("author_id") @db.Uuid
  readingMinutes     Int               @default(3) @map("reading_minutes")
  sourceUrls         String[]          @default([]) @map("source_urls")
  beginnerOrder      Int?              @map("beginner_order")
  verifiedAt         DateTime?         @map("verified_at")
  publishedAt        DateTime?         @map("published_at")
  status             PublishStatus     @default(DRAFT)
  helpfulYes         Int               @default(0) @map("helpful_yes")
  helpfulNo          Int               @default(0) @map("helpful_no")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  category           KnowledgeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId, status, publishedAt])
  @@map("guide_articles")
}

// ───────────── M7 qo‘shimcha: kanallar, shablonlar, bosh sahifa bloklari, ops (TZ 5.6, 7.2, 7.3, 7.7, 14.2, 19.1) ─────────────

/// Foydalanuvchi bildirishnoma kanallari (TZ 7.2): tur bo‘yicha IN_APP/SMS/EMAIL; yo‘q bo‘lsa — standart (14.2).
model NotificationPreference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(60)
  channels  String[] @default([])
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_preferences")
}

/// Taklif shablonlari (TZ 7.3, U11.4): qatorlar va standart shartlar.
model QuoteTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  shopId       String   @map("shop_id") @db.Uuid
  name         String   @db.VarChar(120)
  itemsJson    Json     @map("items_json")
  defaultsJson Json     @default("{}") @map("defaults_json")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("quote_templates")
}

/// Bosh sahifa bloklari (TZ 5.6): 3 tilda, nashrdan oldin preview, versiya va audit.
model SiteBlock {
  id          String        @id @default(uuid()) @db.Uuid
  page        String        @default("HOME") @db.VarChar(40)
  blockType   String        @map("block_type") @db.VarChar(40)
  sortOrder   Int           @default(0) @map("sort_order")
  contentI18n Json          @map("content_i18n")
  draftI18n   Json?         @map("draft_i18n")
  status      PublishStatus @default(DRAFT)
  version     Int           @default(1)
  publishedAt DateTime?     @map("published_at")
  updatedById String?       @map("updated_by_id") @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([page, blockType])
  @@index([page, status, sortOrder])
  @@map("site_blocks")
}

/// Tashqi provayder kvotasi (TZ 7.7, 14.1 provider-quota-poll).
model ProviderQuotaSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String   @db.VarChar(30)
  metric      String   @db.VarChar(40)
  used        Int
  limit       Int?
  failures    Int      @default(0)
  periodStart DateTime @map("period_start")
  capturedAt  DateTime @default(now()) @map("captured_at")

  @@index([provider, capturedAt])
  @@map("provider_quota_snapshots")
}

model OpsDeployment {
  id           String    @id @default(uuid()) @db.Uuid
  service      String    @db.VarChar(20)
  environment  String    @db.VarChar(20)
  version      String    @db.VarChar(60)
  gitSha       String?   @map("git_sha") @db.VarChar(64)
  status       String    @db.VarChar(20)
  startedAt    DateTime  @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  triggeredBy  String?   @map("triggered_by") @db.VarChar(120)
  changelogUrl String?   @map("changelog_url") @db.VarChar(500)

  @@index([service, environment, startedAt])
  @@map("ops_deployments")
}

model OpsAlertEvent {
  id             String    @id @default(uuid()) @db.Uuid
  fingerprint    String    @db.VarChar(120)
  alertName      String    @map("alert_name") @db.VarChar(120)
  severity       String    @db.VarChar(20)
  status         String    @db.VarChar(20)
  startsAt       DateTime  @map("starts_at")
  endsAt         DateTime? @map("ends_at")
  summary        String    @db.VarChar(1000)
  labelsJson     Json      @default("{}") @map("labels_json")
  acknowledgedBy String?   @map("acknowledged_by") @db.Uuid
  acknowledgedAt DateTime? @map("acknowledged_at")

  @@unique([fingerprint, startsAt])
  @@index([status, severity])
  @@map("ops_alert_events")
}
