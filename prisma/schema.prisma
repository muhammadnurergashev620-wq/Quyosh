/// Do‘kon sertifikatlari va belgilar (TZ 4.11): belgi faqat APPROVED va muddati o‘tmagan bo‘lsa ko‘rinadi.
model ShopCertification {
  id                 String     @id @default(uuid()) @db.Uuid
