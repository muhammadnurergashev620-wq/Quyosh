/// Tarif jadvali: hudud + iste’molchi turi + amal davri (PUBLISHED davrlar kesishmaydi — exclusion constraint).
model TariffSchedule {
  id                 String            @id @default(uuid()) @db.Uuid
  regionCode         String            @map("region_code") @db.VarChar(32)
  customerType       CustomerType      @map("customer_type")
  title              String            @db.VarChar(200)
  billingPeriod      String            @default("MONTH") @map("billing_period") @db.VarChar(16)
  fixedChargeMonthly Decimal?          @map("fixed_charge_monthly") @db.Decimal(18, 2)
  touEnabled         Boolean           @default(false) @map("tou_enabled")
  sourceUrl          String?           @map("source_url") @db.VarChar(1000)
  verifiedAt         DateTime?         @map("verified_at")
  verifiedById       String?           @map("verified_by_id") @db.Uuid
  effectiveFrom      DateTime          @map("effective_from") @db.Date
  effectiveUntil     DateTime?         @map("effective_until") @db.Date
  status             PublishStatus     @default(DRAFT)
  version            Int               @default(1)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  tiers              TariffTier[]
  touPeriods         TariffTouPeriod[]

  @@index([regionCode, customerType, status, effectiveFrom])
  @@map("tariff_schedules")
}

model TariffTier {
  id           String         @id @default(uuid()) @db.Uuid
