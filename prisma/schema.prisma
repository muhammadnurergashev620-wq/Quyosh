  maxKwh       Decimal?       @map("max_kwh") @db.Decimal(14, 3)
  ratePerKwh   Decimal        @map("rate_per_kwh") @db.Decimal(18, 6)
  currency     Currency       @default(UZS)
  notes        String?        @db.VarChar(500)
  schedule     TariffSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@map("tariff_tiers")
}

model TariffTouPeriod {
  id         String         @id @default(uuid()) @db.Uuid
