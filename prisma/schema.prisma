/// Mijozning taklif so‘rovi (TZ 7.6, 13.1). Do‘konlarga kontakt ochilmaguncha faqat hudud/parametrlar ko‘rinadi (13.2).
model QuoteRequest {
  id                 String             @id @default(uuid()) @db.Uuid
  number             Int                @unique @default(autoincrement())
  userId             String             @map("user_id") @db.Uuid
  siteId             String?            @map("site_id") @db.Uuid
  calculationId      String?            @map("calculation_id") @db.Uuid
  title              String             @db.VarChar(200)
  systemType         SystemType         @map("system_type")
  requiredCapacityKw Decimal?           @map("required_capacity_kw") @db.Decimal(10, 2)
  batteryNeeded      Boolean            @default(false) @map("battery_needed")
  installationNeeded Boolean            @default(true) @map("installation_needed")
  financingInterest  Boolean            @default(false) @map("financing_interest")
  notes              String?            @db.VarChar(2000)
  regionCode         String?            @map("region_code") @db.VarChar(32)
  districtCode       String?            @map("district_code") @db.VarChar(32)
  status             QuoteRequestStatus @default(OPEN)
  /// PLATFORM yoki WIDGET (TZ 13.6) — analitika uchun.
  source             String             @default("PLATFORM") @db.VarChar(16)
  lastActivityAt     DateTime           @default(now()) @map("last_activity_at")
  closedAt           DateTime?          @map("closed_at")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation("UserQuoteRequests", fields: [userId], references: [id], onDelete: Cascade)
  shops              QuoteRequestShop[]
  quotes             Quote[]

  @@index([userId, status, createdAt])
  @@index([status, lastActivityAt])
  @@map("quote_requests")
}

model QuoteRequestShop {
  id                String                @id @default(uuid()) @db.Uuid
  requestId         String                @map("request_id") @db.Uuid
  shopId            String                @map("shop_id") @db.Uuid
  status            RequestShopStatus     @default(SENT)
  contactRevealedAt DateTime?             @map("contact_revealed_at")
  assignedMemberId  String?               @map("assigned_member_id") @db.Uuid
  pipelineStage     PipelineStage         @default(NEW) @map("pipeline_stage")
  declineReason     String?               @map("decline_reason") @db.VarChar(1000)
  sentAt            DateTime              @default(now()) @map("sent_at")
  viewedAt          DateTime?             @map("viewed_at")
  firstResponseAt   DateTime?             @map("first_response_at")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  request           QuoteRequest          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  shop              Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  assignedMember    ShopMember?           @relation(fields: [assignedMemberId], references: [id], onDelete: SetNull)
  notes             ShopLeadNote[]
  messages          ConversationMessage[]
  siteVisits        SiteVisit[]

  @@unique([requestId, shopId])
  @@index([shopId, status])
  @@map("quote_request_shops")
}

model ShopLeadNote {
  id            String           @id @default(uuid()) @db.Uuid
  requestShopId String           @map("request_shop_id") @db.Uuid
  authorId      String           @map("author_id") @db.Uuid
  body          String           @db.VarChar(4000)
  createdAt     DateTime         @default(now())
  requestShop   QuoteRequestShop @relation(fields: [requestShopId], references: [id], onDelete: Cascade)

  @@index([requestShopId])
  @@map("shop_lead_notes")
}

model ConversationMessage {
