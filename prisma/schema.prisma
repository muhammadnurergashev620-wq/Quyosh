  systemKind        String?          @map("system_kind") @db.VarChar(40)
  attachmentFileIds String[]         @default([]) @map("attachment_file_ids") @db.Uuid
  clientId          String?          @map("client_id") @db.VarChar(64)
  readAt            DateTime?        @map("read_at")
  createdAt         DateTime         @default(now())
  requestShop       QuoteRequestShop @relation(fields: [requestShopId], references: [id], onDelete: Cascade)

  @@unique([requestShopId, clientId])
  @@index([requestShopId, createdAt])
  @@map("conversation_messages")
}

model SiteVisit {
  id                String           @id @default(uuid()) @db.Uuid
  requestShopId     String           @map("request_shop_id") @db.Uuid
