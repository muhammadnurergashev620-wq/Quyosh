/// Qabul qilingan taklif bo‘yicha montaj (TZ 13.1, 13.7).
model Installation {
  id                   String             @id @default(uuid()) @db.Uuid
  quoteId              String             @unique @map("quote_id") @db.Uuid
  requestId            String             @map("request_id") @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  shopId               String             @map("shop_id") @db.Uuid
  status               InstallationStatus @default(AGREED)
  scheduledDate        DateTime?          @map("scheduled_date") @db.Date
  installedAt          DateTime?          @map("installed_at")
  confirmedAt          DateTime?          @map("confirmed_at")
  cancelReason         String?            @map("cancel_reason") @db.VarChar(1000)
  disputeReason        String?            @map("dispute_reason") @db.VarChar(2000)
  checklistTemplateId  String?            @map("checklist_template_id") @db.Uuid
  /// [{code, status: OK/ISSUE/NA, comment, photoFileIds}]
  checklistResultJson  Json?              @map("checklist_result_json")
  checklistCompletedAt DateTime?          @map("checklist_completed_at")
  /// Holatlar tarixi (U9.8 timeline): [{status, at, byUserId, side, note}]
  historyJson          Json               @default("[]") @map("history_json")
  remindersSent        Int                @default(0) @map("reminders_sent")
