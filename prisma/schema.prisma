  @@index([parentId])
  @@map("categories")
}

enum ProductModelStatus {
  PENDING
  APPROVED
  REJECTED
  MERGED
}

/// Yagona uskuna katalogi: bir model — bitta yozuv, do‘konlar unga o‘z narxini qo‘shadi.
model ProductModel {
  id                    String              @id @default(uuid()) @db.Uuid
  categoryId            String              @map("category_id") @db.Uuid
  brand                 String              @db.VarChar(120)
  model                 String              @db.VarChar(160)
  slug                  String              @unique @db.VarChar(200)
  status                ProductModelStatus  @default(PENDING)
  mergedIntoId          String?             @map("merged_into_id") @db.Uuid
  rejectReason          String?             @map("reject_reason") @db.VarChar(2000)
  nominalPowerW         Int?                @map("nominal_power_w")
  efficiencyPct         Decimal?            @map("efficiency_pct") @db.Decimal(7, 4)
  widthMm               Int?                @map("width_mm")
  heightMm              Int?                @map("height_mm")
  weightKg              Decimal?            @map("weight_kg") @db.Decimal(8, 2)
  tempCoeffPmaxPctPerC  Decimal?            @map("temp_coeff_pmax_pct_per_c") @db.Decimal(7, 4)
  vocV                  Decimal?            @map("voc_v") @db.Decimal(8, 3)
  vmpV                  Decimal?            @map("vmp_v") @db.Decimal(8, 3)
  iscA                  Decimal?            @map("isc_a") @db.Decimal(8, 3)
  impA                  Decimal?            @map("imp_a") @db.Decimal(8, 3)
  degradationPctPerYear Decimal?            @map("degradation_pct_per_year") @db.Decimal(7, 4)
  inverterAcKw          Decimal?            @map("inverter_ac_kw") @db.Decimal(12, 4)
  inverterMaxDcV        Decimal?            @map("inverter_max_dc_v") @db.Decimal(8, 2)
  mpptMinV              Decimal?            @map("mppt_min_v") @db.Decimal(8, 2)
  mpptMaxV              Decimal?            @map("mppt_max_v") @db.Decimal(8, 2)
  mpptMaxCurrentA       Decimal?            @map("mppt_max_current_a") @db.Decimal(8, 2)
  batteryVoltageV       Decimal?            @map("battery_voltage_v") @db.Decimal(8, 2)
  batteryCapacityKwh    Decimal?            @map("battery_capacity_kwh") @db.Decimal(14, 4)
  batteryUsableDod      Decimal?            @map("battery_usable_dod") @db.Decimal(7, 6)
  batteryChemistry      String?             @map("battery_chemistry") @db.VarChar(40)
  batteryCycles         Int?                @map("battery_cycles")
  warrantyMonths        Int?                @map("warranty_months")
  specsJson             Json?               @map("specs_json")
  datasheetFileId       String?             @map("datasheet_file_id") @db.Uuid
  proposedByShopId      String?             @map("proposed_by_shop_id") @db.Uuid
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  category              Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  mergedInto            ProductModel?       @relation("ModelMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom            ProductModel[]      @relation("ModelMerge")
  proposedByShop        Shop?               @relation("ProposedModels", fields: [proposedByShopId], references: [id], onDelete: SetNull)
  images                ProductModelImage[]
  shopProducts          ShopProduct[]
  favorites             Favorite[]

  @@unique([brand, model])
  @@index([categoryId, status])
  @@index([nominalPowerW])
  @@index([batteryCapacityKwh])
  @@index([inverterAcKw])
  @@map("product_models")
}

model ProductModelImage {
