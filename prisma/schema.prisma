/// Mijoz obyekti (TZ 7.5). Manzil va nuqta private: public API va do‘konga (kontakt ochilmaguncha) berilmaydi.
model CustomerSite {
  id           String                               @id @default(uuid()) @db.Uuid
  userId       String                               @map("user_id") @db.Uuid
  title        String                               @db.VarChar(120)
  siteType     SiteType                             @default(HOUSE) @map("site_type")
  address      String?                              @db.VarChar(500)
  location     Unsupported("geography(Point,4326)")
  regionCode   String?                              @map("region_code") @db.VarChar(32)
  districtCode String?                              @map("district_code") @db.VarChar(32)
  notes        String?                              @db.VarChar(2000)
  archivedAt   DateTime?                            @map("archived_at")
  createdAt    DateTime                             @default(now())
  updatedAt    DateTime                             @updatedAt
  user         User                                 @relation("UserSites", fields: [userId], references: [id], onDelete: Cascade)
  areas        SiteArea[]

  @@index([userId])
  @@map("customer_sites")
}

/// O‘rnatish maydoni: geometry(Polygon,4326); maydonlar serverda ST_Area(polygon::geography) bilan (TZ 11.3).
model SiteArea {
  id               String                                @id @default(uuid()) @db.Uuid
  siteId           String                                @map("site_id") @db.Uuid
  name             String                                @db.VarChar(120)
  areaType         AreaType                              @default(ROOF) @map("area_type")
  roofShape        RoofShape                             @default(FLAT) @map("roof_shape")
  polygon          Unsupported("geometry(Polygon,4326)")
  projectedAreaM2  Decimal                               @map("projected_area_m2") @db.Decimal(12, 2)
  surfaceAreaM2    Decimal                               @map("surface_area_m2") @db.Decimal(12, 2)
  usableFactor     Decimal                               @map("usable_factor") @db.Decimal(4, 3)
  usableAreaM2     Decimal                               @map("usable_area_m2") @db.Decimal(12, 2)
  azimuthDeg       Int?                                  @map("azimuth_deg")
  tiltDeg          Decimal?                              @map("tilt_deg") @db.Decimal(5, 2)
  shadingLevel     ShadingLevel                          @default(NONE) @map("shading_level")
  obstacleInfoJson Json?                                 @map("obstacle_info_json")
  createdAt        DateTime                              @default(now())
  updatedAt        DateTime                              @updatedAt
  site             CustomerSite                          @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("site_areas")
}

// ───────────── Katalog (TZ 7.4) ─────────────

model Category {
  id                  String         @id @default(uuid()) @db.Uuid
  parentId            String?        @map("parent_id") @db.Uuid
  slug                String         @unique @db.VarChar(120)
  nameI18n            Json           @map("name_i18n")
  descriptionI18n     Json?          @map("description_i18n")
  /// Filtr va forma uchun atributlar sxemasi (U7.5).
  attributeSchemaJson Json?          @map("attribute_schema_json")
  active              Boolean        @default(true)
  sortOrder           Int            @default(0) @map("sort_order")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  parent              Category?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
