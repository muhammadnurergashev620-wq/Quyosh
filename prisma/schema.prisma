generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SHOP
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
  SUSPENDED

  DELETED
}

enum OtpPurpose {
  REGISTER
  LOGIN
  PHONE_VERIFICATION
  PASSWORD_RESET
  CHANGE_PHONE
}

enum OtpStatus {
  ACTIVE
  VERIFIED
  EXPIRED
  BLOCKED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum PolicyType {
  TERMS
  PRIVACY
  PLATFORM_RULES
}

enum PolicyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaAssetStatus {
  UPLOADING
  QUARANTINED
  SCANNING
  PROCESSING
  READY
  REJECTED
  FAILED
}

enum MediaAssetKind {
  PRODUCT_IMAGE
  SHOP_LOGO
  VERIFICATION_DOC
  MESSAGE_ATTACHMENT
  REPORT
  IMPORT
  PORTFOLIO
  USER_AVATAR
  CERTIFICATE
  SUPPORT_ATTACHMENT
  ARTICLE_COVER
}

enum NotificationChannel {
  IN_APP
  PUSH
  SMS
  TELEGRAM
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum UserLocale {
  uz
  oz
  ru
}

enum AccountType {
  INDIVIDUAL
  BUSINESS
}

model User {
  id                   String                   @id @default(uuid()) @db.Uuid
  accountNumber        Int                      @unique @default(autoincrement()) @map("account_number")
  phone                String?                  @unique @db.VarChar(32)
  /// Do‘kon va admin panellariga kirish nomi (kichik harf; admin beradi). Mijoz telefon bilan kiradi.
  login                String?                  @unique @db.VarChar(64)
  email                String?                  @unique @db.VarChar(255)
  /// Google hisobi (sub): Google orqali ro‘yxatdan o‘tgan foydalanuvchi uchun.
  googleId             String?                  @unique @map("google_id") @db.VarChar(64)
  googleEmail          String?                  @map("google_email") @db.VarChar(255)
  passwordHash         String?                  @map("password_hash")
  /// Admin yaratgan/tiklagan vaqtincha parol: birinchi kirishda majburiy almashtiriladi (TZ 3.5, 6.4).
  mustPasswordChange   Boolean                  @default(false) @map("must_password_change")
  firstName            String?                  @map("first_name") @db.VarChar(100)
  lastName             String?                  @map("last_name") @db.VarChar(100)
  avatarUrl            String?                  @map("avatar_url")
  /// Profil rasmi (yuklangan fayl). Google rasmi bo‘lsa `avatarUrl` da; yuklangan rasm doim ustun.
  avatarAssetId        String?                  @unique @map("avatar_asset_id") @db.Uuid
  avatarUpdatedAt      DateTime?                @map("avatar_updated_at")
  /// Admin akkaunt o‘ziga rasm qo‘ya oladimi: faqat superadmin yoqadi (standart — yo‘q).
  adminAvatarAllowed   Boolean                  @default(false) @map("admin_avatar_allowed")
  avatarAsset          MediaAsset?              @relation("UserAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  userRoles            UserRole[]
  status               UserStatus               @default(PENDING)
  phoneVerifiedAt      DateTime?                @map("phone_verified_at")
  lastLoginAt          DateTime?                @map("last_login_at")
  preferences          Json?
  /// TZ 7.2: interfeys tili (uz — lotin, oz — kirill, ru) va hisob turi (jismoniy / yuridik shaxs).
  locale               UserLocale               @default(uz)
  accountType          AccountType              @default(INDIVIDUAL) @map("account_type")
  organization         Organization?
  sites                CustomerSite[]           @relation("UserSites")
  calculations         Calculation[]            @relation("UserCalculations")
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  twoFactorEnabled     Boolean                  @default(true) @map("two_factor_enabled")
  /// Superadmin: boshqa adminlarni yaratish va boshqarish huquqi (oddiy admin — yo‘q).
  isSuperAdmin         Boolean                  @default(false) @map("is_super_admin")
  /// Oddiy adminning huquqlari (bo‘limlar); superadmin uchun e’tiborga olinmaydi.
  adminPermissions     String[]                 @default([]) @map("admin_permissions")
  /// Superadmin tanlaydi: bu admin yangi adminlar yarata oladimi (faqat oddiy admin uchun).
  canCreateAdmins      Boolean                  @default(false) @map("can_create_admins")
  /// Bu admin yangi adminga qaysi huquqlarni bera olishi (superadmin belgilaydi).
  grantablePermissions String[]                 @default([]) @map("grantable_permissions")
  /// Bu adminni yaratgan admin (superadmin yaratgan bo‘lsa ham yoziladi).
  createdByAdminId     String?                  @map("created_by_admin_id") @db.Uuid
  createdByAdmin       User?                    @relation("AdminCreator", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdAdmins        User[]                   @relation("AdminCreator")
  deletedAt            DateTime?                @map("deleted_at")
  /// TZ 16: o‘chirish so‘rovi — 14 kun ichida bekor qilish mumkin, keyin anonimlashtiriladi.
  deletionRequestedAt  DateTime?                @map("deletion_requested_at")
  deletionScheduledAt  DateTime?                @map("deletion_scheduled_at")
  anonymizedAt         DateTime?                @map("anonymized_at")
  refreshTokens        RefreshToken[]
  deviceSessions       DeviceSession[]
  pushTokens           PushToken[]
  otpCodes             OtpCode[]
  policies             PolicyAcceptance[]
  notifications        Notification[]
  auditLogs            AuditLog[]               @relation("AuditActor")
  errorLogs            ErrorLog[]               @relation("ErrorLogUser")
  outboxEvents         OutboxEvent[]            @relation("OutboxCreator")
  mediaAssets          MediaAsset[]             @relation("MediaUploader")
  shopMemberships      ShopMember[]             @relation("ShopMemberUser")
  createdShops         Shop[]                   @relation("ShopCreator")
  quoteRequests        QuoteRequest[]           @relation("UserQuoteRequests")
  installations        Installation[]           @relation("UserInstallations")
  reviews              Review[]                 @relation("UserReviews")
  favorites            Favorite[]               @relation("UserFavorites")
  reportJobs           ReportJob[]              @relation("UserReportJobs")
  notificationPrefs    NotificationPreference[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model PushToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  token      String   @unique @db.VarChar(512)
  platform   String   @default("android") @db.VarChar(16)
  /// Qaysi panel ilovasi (customer/master): bildirishnoma mazmuni shunga moslanadi.
  panel      String?  @db.VarChar(16)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model DeviceSession {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  deviceId   String        @db.VarChar(255)
  status     SessionStatus @default(ACTIVE)
  lastSeenAt DateTime      @default(now()) @map("last_seen_at")
  createdAt  DateTime      @default(now())
  revokedAt  DateTime?     @map("revoked_at")
  userAgent  String?       @map("user_agent") @db.VarChar(400)
  ipAddress  String?       @map("ip_address") @db.VarChar(64)
  panel      String?       @db.VarChar(16)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, status])
  @@map("device_sessions")
}

model RefreshToken {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  tokenHash  String        @unique @map("token_hash") @db.VarChar(255)
  familyId   String        @db.Uuid
  deviceId   String        @db.VarChar(255)
  status     SessionStatus @default(ACTIVE)
  expiresAt  DateTime      @map("expires_at")
  revokedAt  DateTime?     @map("revoked_at")
  lastSeenAt DateTime      @default(now()) @map("last_seen_at")
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deviceId, status])
  @@index([userId, status])
  @@index([familyId])
  @@index([familyId, deviceId, status])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model BlockedPhone {
  id          String   @id @default(uuid()) @db.Uuid
  phone       String   @unique @db.VarChar(32)
  reason      String?  @db.VarChar(500)
  blockedById String?  @map("blocked_by_id") @db.Uuid
  createdAt   DateTime @default(now())

  @@map("blocked_phones")
}

model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @db.Uuid
  phone       String     @db.VarChar(32)
  codeHash    String     @map("code_hash") @db.VarChar(255)
  purpose     OtpPurpose
  status      OtpStatus  @default(ACTIVE)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at")
  verifiedAt  DateTime?  @map("verified_at")
  ipAddress   String?    @map("ip_address") @db.VarChar(64)
  panel       String?    @db.VarChar(16)
  createdAt   DateTime   @default(now())
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, purpose, status])
  @@index([ipAddress, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_codes")
}

model PolicyVersion {
  id          String             @id @default(uuid()) @db.Uuid
  type        PolicyType
  version     String             @db.VarChar(50)
  title       String             @db.VarChar(255)
  content     String
  status      PolicyStatus       @default(DRAFT)
  publishedAt DateTime?          @map("published_at")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  acceptances PolicyAcceptance[]

  @@unique([type, version])
  @@index([type, status])
  @@map("policy_versions")
}

model PolicyAcceptance {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  policyId   String        @db.Uuid
  acceptedAt DateTime      @default(now()) @map("accepted_at")
  ipAddress  String?       @map("ip_address") @db.VarChar(64)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy     PolicyVersion @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@unique([userId, policyId])
  @@index([policyId])
  @@map("policy_acceptances")
}

model Notification {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @db.Uuid
  channel      NotificationChannel
  title        String              @db.VarChar(255)
  body         String
  template     String?             @db.VarChar(150)
  data         Json?
  status       NotificationStatus  @default(PENDING)
  sentAt       DateTime?           @map("sent_at")
  readAt       DateTime?           @map("read_at")
  error        String?
  /// SMS tungi vaqtda (22:00–08:00) kechiktiriladi (TZ 14.2) — shu vaqtda yuboriladi.
  scheduledFor DateTime?           @map("scheduled_for")
  createdAt    DateTime            @default(now())
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([channel, status])
  @@index([status, scheduledFor])
  @@map("notifications")
}

model MediaAsset {
  id                 String           @id @default(uuid()) @db.Uuid
  uploaderId         String           @db.Uuid
  kind               MediaAssetKind
  status             MediaAssetStatus @default(UPLOADING)
  quarantineKey      String?          @map("quarantine_key")
  originalKey        String?          @map("original_key")
  thumbnailKey       String?          @map("thumbnail_key")
  mediumKey          String?          @map("medium_key")
  originalName       String           @map("original_name") @db.VarChar(255)
  declaredMimeType   String           @map("declared_mime_type") @db.VarChar(150)
  detectedMimeType   String?          @map("detected_mime_type") @db.VarChar(150)
  sizeBytes          BigInt           @map("size_bytes")
  scanResult         String?          @map("scan_result") @db.VarChar(50)
  rejectionReason    String?          @map("rejection_reason")
  linkedResourceType String?          @map("linked_resource_type") @db.VarChar(50)
  linkedResourceId   String?          @map("linked_resource_id") @db.Uuid
  attempts           Int              @default(0)
  lastError          String?          @map("last_error")
  cleanedUpAt        DateTime?        @map("cleaned_up_at")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  uploader           User             @relation("MediaUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  avatarOf           User?            @relation("UserAvatar")

  @@index([uploaderId, status])
  @@index([linkedResourceType, linkedResourceId])
  @@index([status, updatedAt])
  @@map("media_assets")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @db.VarChar(255)
  userId         String   @db.Uuid
  method         String   @db.VarChar(10)
  endpoint       String   @db.VarChar(255)
  requestHash    String   @map("request_hash") @db.VarChar(255)
  responseStatus Int?     @map("response_status")
  responseBody   Json?
  resourceType   String?  @map("resource_type") @db.VarChar(100)
  resourceId     String?  @map("resource_id") @db.Uuid
  createdAt      DateTime @default(now())
  expiresAt      DateTime @map("expires_at")

  @@unique([userId, method, endpoint, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  eventName     String       @map("event_name") @db.VarChar(150)
  eventVersion  Int          @default(1) @map("event_version")
  aggregateType String       @map("aggregate_type") @db.VarChar(100)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at")
  publishedAt   DateTime?    @map("published_at")
  lastError     String?      @map("last_error")
  createdById   String?      @db.Uuid
  createdAt     DateTime     @default(now())
  createdBy     User?        @relation("OutboxCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(150)
  targetType String?  @map("target_type") @db.VarChar(100)
  targetId   String?  @map("target_id") @db.Uuid
  before     Json?
  after      Json?
  reason     String?
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  device     String?
  requestId  String?  @map("request_id") @db.VarChar(100)
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model ErrorLog {
  id          String    @id @default(uuid()) @db.Uuid
  /// SERVER | CLIENT
  source      String    @db.VarChar(16)
  /// HTTP | UNHANDLED | UI_CRASH | UI_ERROR | API_ERROR | NETWORK
  kind        String    @db.VarChar(32)
  /// ERROR (5xx, qulash) | WARNING (4xx, foydalanuvchi xatosi)
  severity    String    @db.VarChar(16)
  status      Int?
  code        String?   @db.VarChar(100)
  message     String
  stack       String?
  method      String?   @db.VarChar(10)
  path        String?   @db.VarChar(500)
  pageUrl     String?   @map("page_url") @db.VarChar(500)
  requestId   String?   @map("request_id") @db.VarChar(100)
  userId      String?   @map("user_id") @db.Uuid
  userRole    String?   @map("user_role") @db.VarChar(20)
  panel       String?   @db.VarChar(20)
  platform    String?   @db.VarChar(20)
  userAgent   String?   @map("user_agent") @db.VarChar(400)
  ipAddress   String?   @map("ip_address") @db.VarChar(64)
  appVersion  String?   @map("app_version") @db.VarChar(40)
  context     Json?
  /// Bir xil xatoliklarni guruhlash uchun (manba+tur+kod+status+yo‘l shabloni+xabar boshi).
  fingerprint String    @db.VarChar(64)
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now())
  user        User?     @relation("ErrorLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([fingerprint, createdAt])
  @@index([userId, createdAt])
  @@index([source, severity, createdAt])
  @@index([resolvedAt])
  @@map("error_logs")
}

// ───────────── Do‘kon (TZ 7.3) ─────────────

enum ShopStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
}

enum ShopVerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum ShopCreatedSource {
  SELF
  ADMIN
}

enum ShopMemberRole {
  OWNER
  MANAGER
  STAFF
}

model Shop {
  id                 String                     @id @default(uuid()) @db.Uuid
  slug               String                     @unique @db.VarChar(120)
  name               String                     @db.VarChar(120)
  description        String?                    @db.VarChar(10000)
  logoAssetId        String?                    @map("logo_asset_id") @db.Uuid
  coverAssetId       String?                    @map("cover_asset_id") @db.Uuid
  stir               String?                    @db.VarChar(9)
  phone              String?                    @db.VarChar(32)
  email              String?                    @db.VarChar(255)
  verificationStatus ShopVerificationStatus     @default(NOT_SUBMITTED) @map("verification_status")
  status             ShopStatus                 @default(DRAFT)
  createdSource      ShopCreatedSource          @default(SELF) @map("created_source")
  createdByUserId    String?                    @map("created_by_user_id") @db.Uuid
  createdBy          User?                      @relation("ShopCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  suspendedAt        DateTime?                  @map("suspended_at")
  suspendReason      String?                    @map("suspend_reason") @db.VarChar(2000)
  avgResponseMinutes Int?                       @map("avg_response_minutes")
  ratingAvg          Decimal                    @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount        Int                        @default(0) @map("rating_count")
  archivedAt         DateTime?                  @map("archived_at")
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  members            ShopMember[]
  verificationDocs   ShopVerificationDocument[]
  branches           ShopBranch[]
  products           ShopProduct[]
  services           Service[]
  importJobs         ImportJob[]
  proposedModels     ProductModel[]             @relation("ProposedModels")
  requestShops       QuoteRequestShop[]
  quotes             Quote[]
  installations      Installation[]
  reviews            Review[]
  favorites          Favorite[]
  certifications     ShopCertification[]
  projects           ShopProject[]
  widget             WidgetConfig?
  quoteTemplates     QuoteTemplate[]

  @@index([status])
  @@map("shops")
}

/// Do‘kon egaligining yagona manbai: memberRole = OWNER (har do‘konda aynan bitta — partial unique index, SQL migratsiyada).
model ShopMember {
  id            String             @id @default(uuid()) @db.Uuid
  shopId        String             @map("shop_id") @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  memberRole    ShopMemberRole     @map("member_role")
  permissions   String[]           @default([])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  shop          Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user          User               @relation("ShopMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedLeads QuoteRequestShop[]

  @@unique([shopId, userId])
  @@index([userId])
  @@map("shop_members")
}

/// Yuridik shaxs ma’lumoti (TZ 7.2): accountType = BUSINESS bo‘lganda.
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  name      String   @db.VarChar(200)
  stir      String   @db.VarChar(9)
  address   String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("organizations")
}

/// TZ 3.7.2: egani/a’zoni taklif qilish (bir martalik token, 7 kun).
enum ShopDocType {
  REGISTRATION
  LICENSE
  OTHER
}

enum DocReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model ShopVerificationDocument {
  id         String          @id @default(uuid()) @db.Uuid
  shopId     String          @map("shop_id") @db.Uuid
  fileId     String          @map("file_id") @db.Uuid
  docType    ShopDocType     @map("doc_type")
  status     DocReviewStatus @default(PENDING)
  reviewerId String?         @map("reviewer_id") @db.Uuid
  reviewedAt DateTime?       @map("reviewed_at")
  reason     String?         @db.VarChar(2000)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  shop       Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("shop_verification_documents")
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

/// Filial. `location geography(Point,4326)` va ServiceArea — M3 (PostGIS) migratsiyasida qo‘shiladi.
model ShopBranch {
  id                    String                                @id @default(uuid()) @db.Uuid
  shopId                String                                @map("shop_id") @db.Uuid
  name                  String                                @db.VarChar(120)
  address               String                                @db.VarChar(500)
  regionCode            String?                               @map("region_code") @db.VarChar(32)
  phone                 String?                               @db.VarChar(32)
  openingHoursJson      Json?                                 @map("opening_hours_json")
  holidayExceptionsJson Json?                                 @map("holiday_exceptions_json")
  status                BranchStatus                          @default(ACTIVE)
  version               Int                                   @default(1)
  archivedAt            DateTime?                             @map("archived_at")
  createdAt             DateTime                              @default(now())
  updatedAt             DateTime                              @updatedAt
  /// TZ 12: geography(Point,4326). Yozish/o‘qish faqat GeoRepository orqali ($queryRaw).
  location              Unsupported("geography(Point,4326)")?
  shop                  Shop                                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  offers                ProductOffer[]
  services              Service[]
  serviceAreas          ServiceArea[]

  @@index([shopId])
  @@map("shop_branches")
}

/// Filial xizmat hududi (TZ 7.4, 12): geography(MultiPolygon,4326), max 20 000 km².
model ServiceArea {
  id           String                                      @id @default(uuid()) @db.Uuid
  branchId     String                                      @map("branch_id") @db.Uuid
  geom         Unsupported("geography(MultiPolygon,4326)")
  areaKm2      Decimal                                     @map("area_km2") @db.Decimal(12, 3)
  serviceTypes ServiceType[]                               @map("service_types")
  active       Boolean                                     @default(true)
  createdAt    DateTime                                    @default(now())
  updatedAt    DateTime                                    @updatedAt
  branch       ShopBranch                                  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@map("service_areas")
}

enum SiteType {
  HOUSE
  BUSINESS
  WAREHOUSE
  GARAGE
  OTHER
}

enum AreaType {
  ROOF
  GROUND
  CARPORT
}

enum RoofShape {
