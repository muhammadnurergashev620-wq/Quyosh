}

/// Tijoriy taklif (TZ 13.3). Jami summalar faqat serverda; bitta so‘rovga bitta do‘kondan bitta faol taklif (partial unique, SQL).
model Quote {
  id                         String                 @id @default(uuid()) @db.Uuid
  requestId                  String                 @map("request_id") @db.Uuid
  shopId                     String                 @map("shop_id") @db.Uuid
  currentRevision            Int                    @default(0) @map("current_revision")
  equipmentSubtotal          Decimal                @default(0) @map("equipment_subtotal") @db.Decimal(18, 2)
  installationSubtotal       Decimal                @default(0) @map("installation_subtotal") @db.Decimal(18, 2)
  deliveryCost               Decimal                @default(0) @map("delivery_cost") @db.Decimal(18, 2)
  otherCosts                 Decimal                @default(0) @map("other_costs") @db.Decimal(18, 2)
  discountAmount             Decimal                @default(0) @map("discount_amount") @db.Decimal(18, 2)
  vatIncluded                Boolean                @default(true) @map("vat_included")
  vatRate                    Decimal                @default(12) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount                  Decimal                @default(0) @map("vat_amount") @db.Decimal(18, 2)
  total                      Decimal                @default(0) @db.Decimal(18, 2)
  currency                   Currency               @default(UZS)
  /// USD katalog narxlari so‘mga o‘girilganda ishlatilgan MB kursi (13.3).
  exchangeRateUsd            Decimal?               @map("exchange_rate_usd") @db.Decimal(18, 6)
  exchangeRateDate           DateTime?              @map("exchange_rate_date") @db.Date
  systemPowerKw              Decimal?               @map("system_power_kw") @db.Decimal(10, 2)
  systemType                 SystemType?            @map("system_type")
  warrantyEquipmentMonths    Int?                   @map("warranty_equipment_months")
  warrantyInstallationMonths Int?                   @map("warranty_installation_months")
  warrantyText               String?                @map("warranty_text") @db.VarChar(4000)
  durationDays               Int?                   @map("duration_days")
  includedScope              String?                @map("included_scope") @db.VarChar(4000)
  excludedScope              String?                @map("excluded_scope") @db.VarChar(4000)
  validUntil                 DateTime?              @map("valid_until") @db.Date
  status                     QuoteStatus            @default(DRAFT)
  viewedAt                   DateTime?              @map("viewed_at")
  sentAt                     DateTime?              @map("sent_at")
  decidedAt                  DateTime?              @map("decided_at")
  rejectReason               String?                @map("reject_reason") @db.VarChar(1000)
  expiringNotifiedAt         DateTime?              @map("expiring_notified_at")
  createdById                String                 @map("created_by_id") @db.Uuid
  version                    Int                    @default(1)
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  request                    QuoteRequest           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  shop                       Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items                      QuoteItem[]
  revisions                  QuoteRevision[]
  financingOptions           QuoteFinancingOption[]
  installation               Installation?

  @@index([requestId, shopId, status])
  @@index([status, validUntil])
  @@map("quotes")
}

