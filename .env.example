NODE_ENV=development
# 3000 — TZ 5.2 bo'yicha API porti; mahalliy mashinada band bo'lsa PORT ni o'zgartiring.
PORT=3000
APP_NAME=Quyosh
CORS_ORIGINS=http://localhost:5170,http://localhost:5173,http://localhost:5174,http://localhost:5175
# Proksi ortida: son (qatlamlar), 'loopback' yoki 'true'. Bo'sh bo'lsa X-Forwarded-For hisobga olinmaydi.
TRUST_PROXY=

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/quyosh
# Neon (Render): DATABASE_URL — POOLED ulanish (host'da -pooler), oxirida ?sslmode=require&pgbouncer=true&connect_timeout=15&connection_limit=5
# DIRECT_URL — Neon DIRECT ulanish (pooler'siz): migratsiya va seed uchun (scripts/render-build.sh). Mahalliyda kerak emas.
DIRECT_URL=
# Upstash: rediss://default:PAROL@HOST.upstash.io:6379 (TLS avtomatik yoqiladi)
REDIS_URL=redis://localhost:6379
# Render build: true bo'lsa prisma seed ishlaydi (FAQAT birinchi deploy; admin parolini qayta yozadi).
RUN_SEED=
# Render: servisning https manzili (vidjet/embed havolalari)
PUBLIC_API_URL=

JWT_SECRET=
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
# Faqat NODE_ENV!=production: OTP kodi API javobida va kirish ekranida ko'rinadi (TZ 6.4). Production'da yoqilsa ilova ishga tushmaydi.
OTP_DEV_ECHO=true
OTP_DEV_ECHO_AUTH=true
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh sessiya muddati, daqiqada (sliding: har yangilanishda qayta boshlanadi). Standart — 30 kun.
REFRESH_TOKEN_TTL_MINUTES=43200
MAX_ACTIVE_DEVICES=2

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=quyosh-media
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=true
STORAGE_MAX_UPLOAD_SIZE_BYTES=
STORAGE_SIGNED_URL_TTL_SECONDS=

CLAMAV_HOST=
CLAMAV_PORT=
CLAMAV_TIMEOUT_MS=

OUTBOX_JOB_ATTEMPTS=
OUTBOX_JOB_BACKOFF_MS=

# Birinchi Super Admin (seed): login (standart «admin») + parol >= 12 belgi; telefon ixtiyoriy.
ADMIN_LOGIN=admin
ADMIN_PHONE=
ADMIN_PASSWORD=
METRICS_TOKEN=

# Telegram — faqat operatorlar uchun ichki ogohlantirishlar (OTP zaxira, xavfsizlik, alertlar); ixtiyoriy.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OTP_CHAT_ID=
TELEGRAM_OTP_THREAD_ID=
TELEGRAM_CREDENTIALS_CHAT_ID=
TELEGRAM_CREDENTIALS_THREAD_ID=
TELEGRAM_SECURITY_THREAD_ID=
TELEGRAM_SESSIONS_THREAD_ID=
TELEGRAM_CHAT_ID=
TELEGRAM_BLOCKED_CHAT_IDS=
TELEGRAM_ALERTS_THREAD_ID=
TELEGRAM_ALERT_MIN_STATUS=

# Ops: Alertmanager/CI webhooklari imzosi va provayderlarning oylik limitlari (TZ 19.1.1)
OPS_WEBHOOK_SECRET=
ESRI_GEOCODE_MONTHLY_LIMIT=20000
ESRI_BASEMAP_MONTHLY_LIMIT=
PVGIS_MONTHLY_LIMIT=
NASA_POWER_MONTHLY_LIMIT=
SMS_MONTHLY_LIMIT=
EMAIL_MONTHLY_LIMIT=

# ── TZ 18: xarita, quyosh ma'lumoti, monitoring (M3+ da ishlatiladi) ──
MAP_TILE_PROVIDER=ESRI
MAP_TILE_API_KEY=
MAP_BASEMAP_STYLE=arcgis/streets
MAP_SATELLITE_STYLE=arcgis/imagery
MAP_FALLBACK_STYLE_URL=
GEOCODING_API_KEY=
PVGIS_BASE_URL=
NASA_POWER_BASE_URL=

# Faqat dev: SEED_DEMO=true bilan namunaviy do‘konlar egasi
DEMO_USER_PHONE=
DEMO_USER_PASSWORD=
# Dev/test: tashqi solar provayderlarga chiqmaslik (DEFAULT usuli)
SOLAR_FETCH=
EXCHANGE_RATE_FETCH=

# Aloqa ma'lumotlari (ixtiyoriy; frontend): do'kon kirish sahifasida «parolni tiklash uchun administratorga murojaat qiling» ostida va bosh sayt footer'ida («Hamkorlik uchun aloqa») ko'rsatiladi.
VITE_SUPPORT_PHONE=
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_TELEGRAM=
